# Development environment template.
# Copy to .env (`cp .env.example .env`) and adjust as needed.
# .env is gitignored — never commit it. See docs/INFRASTRUCTURE.md for setup.
#
# The defaults below match docker-compose.yml, so `cp .env.example .env`
# followed by `docker compose up` boots the stack as-is. Only the AR
# encryption keys must be replaced with generated values (see below).

RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true

# Database
# Inside Docker Compose the DB host is `db` (the service name), not localhost.
# config/database.yml uses hardcoded postgres/postgres for the primary DB and
# reads QUEUE_DATABASE_URL for the SolidQueue `queue` connection. Deliberately
# a separate var from DATABASE_HOST/PORT: a generic DATABASE_URL would be
# picked up by Rails as a global override and silently redirect the `test`
# environment's primary connection to the dev database too.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gabi_development
QUEUE_DATABASE_URL=postgresql://postgres:postgres@db:5432/gabi_development
DATABASE_HOST=db
DATABASE_PORT=5432

# CORS
# Comma-separated allowed origins (config/initializers/cors.rb).
# Defaults to http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

# Application 
# Public registrations are auto-assigned to the therapist with this email
# (app/controllers/users/registrations_controller.rb:8). Falls back to the
# oldest therapist user if unset.
THERAPIST_EMAIL=therapist@example.com

# ActiveRecord Encryption (REQUIRED to read/write clinical notes) 
# Encrypts clinical_notes.content (config/application.rb:38-40).
# Generate real values with: bin/rails db:encryption:init
AR_ENCRYPTION_PRIMARY_KEY=replace_me_generate_with_encryption_init
AR_ENCRYPTION_DETERMINISTIC_KEY=replace_me_generate_with_encryption_init
AR_ENCRYPTION_KEY_DERIVATION_SALT=replace_me_generate_with_encryption_init

# Optional
# Set by docker-compose.yml already; only needed for standalone runs where you
# want jobs processed inside Puma (config/puma.rb:38).
# SOLID_QUEUE_IN_PUMA=true
#
# The JWT secret is read from Rails credentials (devise_jwt_secret_key) and
# falls back to secret_key_base in dev/test — no ENV var needed for local dev.
# In production it MUST be set in credentials (config/initializers/devise.rb).
